nstanceID="xmp.iid:65d223fe-74b3-c146-af6b-1bd13b33f7bf" stEvt:when="2026-07-10T13:51:20+02:00" stEvt:softwareAgent="Adobe Photoshop 27.7 (Windows)" stEvt:changed="/"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:4451a59c-32eb-8b4e-9331-96c51c4ff45d" stEvt:when="2026-07-10T13:51:20+02:00" stEvt:softwareAgent="Adobe Photoshop 27.7 (Windows)" stEvt:changed="/"/> </rdf:Seq> </xmpMM:History> <xmp:XMPFileStamps> <rdf:Seq> <rdf:li>2026-07-10T12:45:40+01:00</rdf:li> </rdf:Seq> </xmp:XMPFileStamps> <dc:title> <rdf:Alt> <rdf:li xml:lang="x-default">Baltyk II and III - WTG Foundation Installation - Monopiles and Transition Pieces - Summer 2026</rdf:li> </rdf:Alt> </dc:title> <dc:subject> <rdf:Bag> <rdf:li>Offshore Wind</rdf:li> <rdf:li>Renewable</rdf:li> </rdf:Bag> </dc:subject> <dc:creator> <rdf:Seq> <rdf:li>Thomas Sola</rdf:li> </rdf:Seq> </dc:creator> <dc:description> <rdf:Alt> <rdf:li xml:lang="x-default">Heerema Marine Contractors (HMC) is contracted to transport and install 100 foundations for the Baltyk II and III projects. The Monopiles are transported on the GPO vessels (GPO Amethyst, GPO Grace and GPO Sapphire) and the Transition Pieces are transported with Rolldock vessels (Rolldock Storm, Rolldock Sea and Rolldock Sun). The foundations are installed with the SSCV (Semi-Submersible Crane Vessel) Thialf. The Eems Duisburg is following with completion activities for the Transition pieces.  The campaign started on May 1st 2026 and is currently ongoing.</rdf:li> </rdf:Alt> </dc:description> <dc:rights> <rdf:Alt> <rdf:li xml:lang="x-default">Equinor</rdf:li> </rdf:Alt> </dc:rights> <fwr:UploadInfo fwr:UploadTime="2026-05-06T02:13:07.504468Z"/> </rdf:Description> </rdf:RDF> </x:xmpmeta>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 <?xpacket end="w"?>ÿÛ␀C␀ÿÛ␀CÿÀ␀¦~␀ÿÄ␀␀␀␀␀␀␀␀␀␀␀␀␀	␀
