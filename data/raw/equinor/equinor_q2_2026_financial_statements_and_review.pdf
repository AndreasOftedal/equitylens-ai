-350mm f/3.5-5.6L USM" aux:LensSerialNumber="0000000000" dcterms:valid="2031-05-04" skyview:CustomField21="Equinor Mediabank" skyview:CustomField24="Equinor" skyview:CustomField37="Steffen Skyldstad" skyview:CustomField40="Approved" skyview:CustomDate1="2026-05-04" crs:HasCrop="False" crs:AlreadyApplied="True" exifEX:LensModel="EF35-350mm f/3.5-5.6L USM"> <xmpMM:History> <rdf:Seq> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:792722f7-36b9-3142-bffa-1c7bd9ff6589" stEvt:when="2026-07-10T11:33:34+02:00" stEvt:softwareAgent="Adobe Photoshop 27.7 (Windows)" stEvt:changed="/"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:73e4dc15-c3ba-734f-b731-a0098b7ec81c" stEvt:when="2026-07-10T11:33:34+02:00" stEvt:softwareAgent="Adobe Photoshop 27.7 (Windows)" stEvt:changed="/"/> </rdf:Seq> </xmpMM:History> <xmp:XMPFileStamps> <rdf:Seq> <rdf:li>2026-07-10T08:58:30+01:00</rdf:li> </rdf:Seq> </xmp:XMPFileStamps> <dc:title> <rdf:Alt> <rdf:li xml:lang="x-default">On the bridge of Eagle Balder</rdf:li> </rdf:Alt> </dc:title> <dc:subject> <rdf:Bag> <rdf:li>oil</rdf:li> <rdf:li>crude oil</rdf:li> <rdf:li>shuttle tanker</rdf:li> <rdf:li>Gullfaks</rdf:li> <rdf:li>Eagle Balder</rdf:li> <rdf:li>ship</rdf:li> </rdf:Bag> </dc:subject> <dc:creator> <rdf:Seq> <rdf:li>Colin Dobinson</rdf:li> </rdf:Seq> </dc:creator> <dc:description> <rdf:Alt> <rdf:li xml:lang="x-default">Captain Arne Hermundsli (employed by OSMT) navigates the shuttle tanker Eagle Balder (owned by OSMT/AET) towards the loading zone at Gullfaks on the night of 4th May, 2026, in a snowstorm. Load #GF5000</rdf:li> </rdf:Alt> </dc:description> <dc:rights> <rdf:Alt> <rdf:li xml:lang="x-default">Equinor</rdf:li> </rdf:Alt> </dc:rights> <fwr:UploadInfo fwr:UploadTime="2026-05-11T08:35:37.174711Z"/> <skyview:CustomBag3> <rdf:Bag> <rdf:li>Gullfaks</rdf:li> </rdf:Bag> </skyview:CustomBag3> </rdf:Description> </rdf:RDF> </x:xmpmeta>                                                                                            